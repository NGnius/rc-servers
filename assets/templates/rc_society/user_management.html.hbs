<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <!-- Primary Meta Tags -->
  <title>User - Openjam</title>
  <meta name="title" content="User - Openjam" />
  <meta name="description" content="User management for third-party Robocraft servers" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content="website" />
  <meta property="og:url" content="https://git.ngram.ca/OpenJam/rc-servers" />
  <meta property="og:title" content="User - Openjam" />
  <meta property="og:description" content="View your user for third-party Robocraft servers" />
  <meta property="og:image" content="https://git.ngram.ca/OpenJam/rc-servers/raw/branch/main/assets/robocraft/favicon.jpg" />

  <!-- Twitter -->
  <meta property="twitter:card" content="summary" />
  <meta property="twitter:url" content="https://git.ngram.ca/OpenJam/rc-servers" />
  <meta property="twitter:title" content="User - Openjam" />
  <meta property="twitter:description" content="View your user for third-party Robocraft servers" />
  <meta property="twitter:image" content="https://git.ngram.ca/OpenJam/rc-servers/raw/branch/main/assets/robocraft/favicon.jpg" />


  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  {{> stylesheet}}
</head>
<body>
  <div class="form-stripe">
    <div class="form-header-right">
      Welcome {{form.display_name}}! |
      <a href="/">Home</a> |
      <a href="/dashboard">Dashboard</a> |
      <a href="/logout">Sign Out</a>
    </div>
    <h1 class="form-banner">{{form.display_name}} Management</h1>
    {{#if error}}
      <div class="form-error">
        <p class="form-error-message">{{error}}</p>
      </div>
    {{/if}}
    {{#if form.success_message}}
      <div class="form-success">
        <p class="form-success-message">{{form.success_message}}</p>
      </div>
    {{/if}}

    <div class="access-grid">
        <form method="post" class="inline-form">
            <div class="access-box access-box-input">
                <input type="hidden" id="action" name="action" value="NameChange"/>
                <input type="hidden" id="original_name" name="original_name" value="{{form.display_name}}"/>
                <div class="box-details">
                    <div class="box-details-key">New Name</div>
                    <div class="box-details-value" style="padding-left:0;padding-bottom:2px;">
                        <input type="text" id="new_name" name="new_name" class="form-input-box" value="{{form.display_name}}" required />
                    </div>
                </div>
                <input class="form-submit-button" style="width:50%;" type="submit" value="Change username" />
            </div>
        </form>
        <div class="access-box">
            <a href="/user/delete">
                <div class="access-box-banner access-box-danger">
                    Delete Account
                </div>
            </a>
        </div>
    </div>

    <footer>
      <div class="footer">
        {{version}}
        | <a href="{{source_url}}#readme">About</a>
        | <a href="https://liberapay.com/NGram">Support Me</a>
      </div>
    </footer>
  </div>
</body>
</html>
